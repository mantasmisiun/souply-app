{
  "cli": {
    "version": ">= 18.8.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "channel": "production",
      "env": {
        "GOOGLE_MAPS_API_KEY_ANDROID": "AIzaSyAUes7IPZzdfpYjroLMLjODP2FnlUYCmHg"
      }
    },
    "ios-dev": {
      "distribution": "internal",
      "channel": "dev",
      "env": {
        "APP_VARIANT": "dev"
      }
    },
    "android-dev": {
      "distribution": "internal",
      "channel": "dev",
      "android": { "buildType": "apk" },
      "env": {
        "APP_VARIANT": "dev",
        "GOOGLE_MAPS_API_KEY_ANDROID": "AIzaSyAUes7IPZzdfpYjroLMLjODP2FnlUYCmHg"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "GOOGLE_MAPS_API_KEY_ANDROID": "AIzaSyAUes7IPZzdfpYjroLMLjODP2FnlUYCmHg"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
