{
  "name": "souply-app",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "run:dev:android": "APP_VARIANT=dev expo run:android --no-bundler",
    "run:dev:ios": "npm run dev",
    "start:dev": "APP_VARIANT=dev expo start --dev-client",
    "dev": "npm run sync-shared && APP_VARIANT=dev expo start --dev-client --clear",
    "dev:usb": "adb reverse tcp:8081 tcp:8081 && npm run sync-shared && APP_VARIANT=dev expo start --dev-client --clear --localhost",
    "lint": "expo lint",
    "sync-shared": "rm -rf ./shared && cp -r ../shared ./shared && rm -rf ./shared/.git",
    "build:dev:ios": "node scripts/require-branch.js dev && npm run sync-shared && eas build --profile development -p ios",
    "build:dev:android": "node scripts/require-branch.js dev && npm run sync-shared && eas build --profile development -p android",
    "build:staging:ios": "node scripts/require-branch.js staging && npm run sync-shared && eas build --profile staging -p ios",
    "build:staging:android": "node scripts/require-branch.js staging && npm run sync-shared && eas build --profile staging -p android",
    "build:staging:android:local": "node scripts/require-branch.js staging && npm run sync-shared && mkdir -p builds && eas build --profile staging -p android --local --output builds/souply-staging.apk",
    "build:prod:ios": "node scripts/require-branch.js main && npm run sync-shared && eas build --profile production -p ios",
    "build:prod:android": "node scripts/require-branch.js main && npm run sync-shared && eas build --profile production -p android",
    "test": "jest",
    "postinstall": "patch-package",
    "prepare": "node .husky/install.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|standard-navigation|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)",
      "**/*.test.[jt]s?(x)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-native-menu/menu": "^2.0.0",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.5.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/query-async-storage-persister": "^5.104.2",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-persist-client": "^5.104.2",
    "expo": "^57.0.0",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.9",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.6",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.4",
    "expo-share-intent": "^8.0.1",
    "expo-sharing": "~57.0.7",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.10",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.3",
    "patch-package": "^8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.16",
    "react-native": "0.87.1",
    "react-native-document-scanner-plugin": "^2.0.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.22.6",
    "react-native-maps": "1.29.11",
    "react-native-qrcode-styled": "^0.4.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.29.0",
    "react-native-svg": "15.15.5",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "reanimated-color-picker": "^5.1.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.0.2",
    "@react-native/jest-preset": "^0.87.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "lint-staged": "^17.6.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --fix"
  }
}
