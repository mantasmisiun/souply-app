{
  "name": "souply-app",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "run:dev:android": "APP_VARIANT=dev expo run:android --no-bundler",
    "run:dev:ios": "npm run dev",
    "start:dev": "APP_VARIANT=dev expo start --dev-client",
    "dev": "npm run sync-shared && APP_VARIANT=dev expo start --dev-client --clear",
    "lint": "expo lint",
    "sync-shared": "rm -rf ./shared && cp -r ../shared ./shared && rm -rf ./shared/.git",
    "build:dev:ios": "node scripts/require-branch.js dev && npm run sync-shared && eas build --profile development -p ios",
    "build:dev:android": "node scripts/require-branch.js dev && npm run sync-shared && eas build --profile development -p android",
    "build:staging:ios": "node scripts/require-branch.js staging && npm run sync-shared && eas build --profile staging -p ios",
    "build:staging:android": "node scripts/require-branch.js staging && npm run sync-shared && eas build --profile staging -p android",
    "build:staging:android:local": "node scripts/require-branch.js staging && npm run sync-shared && mkdir -p builds && eas build --profile staging -p android --local --output builds/souply-staging.apk",
    "build:prod:ios": "node scripts/require-branch.js main && npm run sync-shared && eas build --profile production -p ios",
    "build:prod:android": "node scripts/require-branch.js main && npm run sync-shared && eas build --profile production -p android",
    "test": "jest",
    "postinstall": "patch-package",
    "prepare": "node .husky/install.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)",
      "**/*.test.[jt]s?(x)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-native-menu/menu": "^2.0.0",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.3.14",
    "@sentry/react-native": "~7.2.0",
    "@shopify/react-native-skia": "2.10.1",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "expo": "~54.0.35",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.1",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-share-intent": "^5.1.1",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.18",
    "expo-web-browser": "~15.0.11",
    "i18next": "^26.3.6",
    "patch-package": "^8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-document-scanner-plugin": "^2.0.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.22.2",
    "react-native-maps": "1.29.0",
    "react-native-qrcode-styled": "^0.4.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.5.3",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.5",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.11.3",
    "reanimated-color-picker": "^5.1.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.0.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.17",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "lint-staged": "^17.2.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --fix"
  }
}
