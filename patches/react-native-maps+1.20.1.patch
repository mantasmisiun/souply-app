-    [_reactSubviews insertObject:(UIView *)subview atIndex:(NSUInteger) atIndex];
+    // PATCH(souply): clamp the index. Under the Fabric interop layer
+    // (RCTLegacyViewManagerInteropComponentView) rapid marker remove+insert
+    // batches can deliver an index beyond the current array bounds, and the
+    // unchecked insert throws NSRangeException -> SIGABRT (crash log
+    // 2026-07-04, store-resolution map). _reactSubviews is bookkeeping only —
+    // annotations/overlays are added to MKMapView above — so clamping is safe.
+    NSUInteger safeIndex = MIN((NSUInteger)MAX(atIndex, 0), _reactSubviews.count);
+    [_reactSubviews insertObject:(UIView *)subview atIndex:safeIndex];
